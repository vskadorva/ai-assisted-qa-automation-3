# -----------------------------------------------------------------------------
# Run tests (required to clone the repo and run Playwright locally or in CI E2E)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# Base URL of the Didaxis test environment (Playwright `use.baseURL`).
DIDAXIS_URL=https://test.didaxis.studio

# Primary test account used by auth setup and UI tests.
DIDAXIS_EMAIL=your-test-user@example.com

# Password for DIDAXIS_EMAIL.
DIDAXIS_PASSWORD=your-password-here

# Bearer JWT for DELETE /api/programs cleanup. Often left empty locally;
# the cleanup fixture can refresh it after login. CI may supply a fresh token.
DIDAXIS_API_TOKEN=

# -----------------------------------------------------------------------------
# Optional — second account for permission / role probes (not required for suite)
# -----------------------------------------------------------------------------

# Alternate user email (e.g. read-only or non-admin).
# DIDAXIS_ALT_EMAIL=alt-user@example.com

# Password for DIDAXIS_ALT_EMAIL.
# DIDAXIS_ALT_PASSWORD=your-alt-password-here

# -----------------------------------------------------------------------------
# Agent / CI setup (not needed for `npx playwright test` alone)
# Used by `.github/workflows/test-generation.yml` and Cursor MCP (Jira, agent).
# Configure the same names as GitHub Actions secrets for scheduled backlog runs.
# MCP Atlassian tokens are usually set in Cursor Settings → MCP, not only in `.env`.
# -----------------------------------------------------------------------------

# Cursor API key for the headless `agent` CLI in test-generation workflow.
CURSOR_API_KEY=cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Atlassian Cloud API token (created at id.atlassian.com → Security → API tokens).
# Use with ATLASSIAN_EMAIL for Basic auth to Jira REST (not your account password).
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira / Confluence site base URL (no trailing slash).
ATLASSIAN_BASE_URL=https://your-site.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN for Jira API calls.
ATLASSIAN_EMAIL=you@example.com
